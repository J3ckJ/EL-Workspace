{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{ if .Env.EL_PROJECT_LABEL }}EL · {{ .Env.EL_PROJECT_LABEL }} · {{ .Env.EL_TASK_LABEL }}{{ else }}{{ .Shell }} · {{ .Folder }}{{ end }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "leading_diamond": "\ue0b6",
      "trailing_diamond": "\ue0b4",
      "segments": [
        {
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#071127",
          "background": "#73A5FF",
          "template": " \ue70f "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#E8F1FF",
          "background": "#34466D",
          "template": " {{ .UserName }}@{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#E8F1FF",
          "background": "#17213A",
          "template": " \uf07c  {{ .Path }} ",
          "options": {
            "style": "mixed",
            "folder_icon": "",
            "home_icon": "~",
            "folder_separator_icon": " \ue0b1 ",
            "max_depth": 4
          }
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#E8F1FF",
          "background": "#2D7180",
          "template": "{{ if .Env.EL_PROJECT_LABEL }}  {{ .Env.EL_PROJECT_LABEL }} · {{ .Env.EL_TASK_ID }} {{ end }}"
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#E8F1FF",
          "background": "#20385C",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#10161D{{ end }}"
          ],
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#E6A13A{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#B69CFF{{ end }}",
            "{{ if gt .Ahead 0 }}#73A5FF{{ end }}",
            "{{ if gt .Behind 0 }}#FF8A80{{ end }}"
          ],
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \uf01c {{ .StashCount }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_stash_count": true,
            "source": "cli"
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#FFFFFF",
          "background": "#306998",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} · {{ end }}{{ .Full }}{{ end }} ",
          "options": {
            "display_mode": "context",
            "fetch_virtual_env": true
          }
        },
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#FFFFFF",
          "background": "#3C7A4B",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "options": {
            "display_mode": "context",
            "fetch_package_manager": true
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#9DAAC5",
          "template": "\udb81\udc1b {{ .FormattedMs }}  ",
          "options": {
            "threshold": 750,
            "style": "austin"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#66758F",
          "template": "\udb81\udd54 {{ .CurrentDate | date .Format }}",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#81D4A0",
          "foreground_templates": [
            "{{ if .Error }}#FF6B6B{{ end }}"
          ],
          "template": "\u2570\u2500 {{ if .Error }}\uf071 {{ .Code }} {{ end }}\u276f",
          "options": {
            "always_enabled": true
          }
        }
      ]
    }
  ]
}
